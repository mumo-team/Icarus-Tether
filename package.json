{
  "name": "icarus-tether",
  "private": true,
  "version": "0.1.0",
  "description": "Icarus-Tether — MCP 행동 오염흐름 추적 보안 게이트웨이",
  "workspaces": [
    "shared/types",
    "policy-engine",
    "proxy",
    "dashboard",
    "dashboard/server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:proxy": "npm run dev -w proxy",
    "dev:policy": "npm run dev -w policy-engine",
    "dev:dashboard": "npm run dev -w dashboard",
    "setup:claude": "npm run setup:claude -w proxy"
  },
  "engines": {
    "node": ">=20"
  },

  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^26.1.0"
  }
}

